module character_render (
    input wire clk,
    input wire [9:0] vga_x,
    input wire [9:0] vga_y,
    input wire [9:0] sprite_x,
    input wire [9:0] sprite_y,
    input wire [255:0] hex_filename, // Hex dosya adı için string input
    output reg [7:0] pixel_data,
    output reg pixel_on
);
    parameter SPRITE_WIDTH = 32;
    parameter SPRITE_HEIGHT = 120; // Ken sprite'ı 120 satır yüksekliğinde
    
    reg [12:0] rom_addr;
    reg [7:0] rom_data;
    reg [7:0] sprite_rom [0:(SPRITE_WIDTH*SPRITE_HEIGHT)-1];
    
    // Hex dosyasını yükleme için task
    task load_hex_file;
        input [255:0] filename;
        begin
            $readmemh(filename, sprite_rom);
        end
    endtask
    
    // İlk yükleme veya dosya değişikliğinde çağrılır
    initial begin
        load_hex_file(hex_filename);
    end
    
    // Dosya adı değiştiğinde yeniden yükle
    always @(hex_filename) begin
        load_hex_file(hex_filename);
    end
    
    wire [9:0] scaled_x = (vga_x - sprite_x) >> 1;  // divide by 2
    wire [9:0] scaled_y = (vga_y - sprite_y) >> 1;  // divide by 2
    wire inside_sprite = (scaled_x < SPRITE_WIDTH) && (scaled_y < SPRITE_HEIGHT);
    
    always @(posedge clk) begin
        if (inside_sprite) begin
            rom_addr <= scaled_y * SPRITE_WIDTH + scaled_x;
            rom_data <= sprite_rom[rom_addr];
            pixel_data <= rom_data;
            pixel_on <= (rom_data != 8'hFF); // optional transparency
        end else begin
            pixel_data <= 8'b0;
            pixel_on <= 0;
        end
    end
endmodule