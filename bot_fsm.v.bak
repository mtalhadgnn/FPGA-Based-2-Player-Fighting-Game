module bot_fsm(
    input clk,
    input reset,
    input sw1,
    input clk_60hz,
    input manual_step,
    output reg move_left,
    output reg move_right,
    output reg attack,
    output reg [9:0] player,
    output reg [2:0] state
);
    
    parameter IDLE           = 3'b000;
    parameter MOVING_L       = 3'b001;
    parameter MOVING_R       = 3'b010;
    parameter ATTACK_STARTUP = 3'b011;
    parameter ATTACK_ACTIVE  = 3'b100;
    parameter ATTACK_RECOVER = 3'b101;

    reg [2:0] current_state, next_state;
    reg [3:0] frame_counter;

    wire game_clk;
    assign game_clk = (sw1 == 1'b0) ? clk_60hz : manual_step;

    parameter STARTUP_FRAMES  = 5;
    parameter ACTIVE_FRAMES   = 2;
    parameter RECOVER_FRAMES  = 15;

    parameter STEP_LEFT   = -3;
    parameter STEP_RIGHT  = 2;
    parameter LEFT_BOUND  = 0;
    parameter RIGHT_BOUND = 576;

	 // LFSR as in 
    reg [7:0] lfsr_reg;
    wire feedback;
    assign feedback = lfsr_reg[7] ^ lfsr_reg[5] ^ lfsr_reg[4] ^ lfsr_reg[3];
    
    // LFSR update on system clock
    always @(posedge clk or posedge reset) begin
        if (reset) begin
            lfsr_reg <= 8'hA5;
        end else begin
            lfsr_reg <= {lfsr_reg[6:0], feedback};
        end
    end
    
    // Bot decision logic
    reg [7:0] decision_counter;
    reg [2:0] bot_action;
    
    parameter BOT_IDLE       = 3'b000;
    parameter BOT_MOVING_L   = 3'b001;
    parameter BOT_MOVING_R   = 3'b010;
    parameter BOT_ATTACK     = 3'b011;
    parameter BOT_MOVE_L_ATK = 3'b100;
    parameter BOT_MOVE_R_ATK = 3'b101;
    
    // Bot behavior update
    always @(posedge game_clk or posedge reset) begin
        if (reset) begin
            decision_counter <= 8'd0;
            bot_action <= BOT_IDLE;
        end else begin
            if (decision_counter == 0) begin
                // Make new decision based on LFSR
                decision_counter <= lfsr_reg[3:0] + 4'd3; // 3-18 frames duration
                
                case (lfsr_reg[7:5])
                    3'b000: bot_action <= BOT_IDLE;
                    3'b001: bot_action <= BOT_MOVING_L;
                    3'b010: bot_action <= BOT_MOVING_R;
                    3'b011: bot_action <= BOT_ATTACK;
                    3'b100: bot_action <= BOT_MOVE_L_ATK;
                    3'b101: bot_action <= BOT_MOVE_R_ATK;
                    default: bot_action <= BOT_IDLE;
                endcase
            end else begin
                decision_counter <= decision_counter - 1;
            end
        end
    end
    
    // Convert bot action to button presses
    always @(*) begin
        case (bot_action)
            BOT_IDLE: begin
                move_left = 1'b0;
                move_right = 1'b0;
                attack = 1'b0;
            end
            BOT_MOVING_L: begin
                move_left = 1'b1;
                move_right = 1'b0;
                attack = 1'b0;
            end
            BOT_MOVING_R: begin
                move_left = 1'b0;
                move_right = 1'b1;
                attack = 1'b0;
            end
            BOT_ATTACK: begin
                move_left = 1'b0;
                move_right = 1'b0;
                attack = 1'b1;
            end
            BOT_MOVE_L_ATK: begin
                move_left = 1'b1;
                move_right = 1'b0;
                attack = 1'b1;
            end
            BOT_MOVE_R_ATK: begin
                move_left = 1'b0;
                move_right = 1'b1;
                attack = 1'b1;
            end
            default: begin
                move_left = 1'b0;
                move_right = 1'b0;
                attack = 1'b0;
            end
        endcase
    end

    // FSM (same logic as your original)
    always @(posedge game_clk or posedge reset) begin
        if (reset) begin
            current_state <= IDLE;
            player <= 476;
            frame_counter <= 0;
        end else begin
            current_state <= next_state;

            case (current_state)
                MOVING_L: if (player > LEFT_BOUND)
                              player <= player + STEP_LEFT;
                MOVING_R: if (player < RIGHT_BOUND)
                              player <= player + STEP_RIGHT;
            endcase

            if (current_state != next_state)
                frame_counter <= 0;
            else if (current_state == ATTACK_STARTUP ||
                     current_state == ATTACK_ACTIVE ||
                     current_state == ATTACK_RECOVER)
                frame_counter <= frame_counter + 1;
            else
                frame_counter <= 0;
        end
    end

    // State transitions (same logic as your original)
    always @(*) begin
        next_state = current_state;
        case (current_state)
            IDLE: begin
                if (attack)         next_state = ATTACK_STARTUP;
                else if (move_left) next_state = MOVING_L;
                else if (move_right) next_state = MOVING_R;
            end
            MOVING_L: begin
                if (!move_left)
                    next_state = IDLE;
            end
            MOVING_R: begin
                if (!move_right)
                    next_state = IDLE;
            end
            ATTACK_STARTUP:
                if (frame_counter >= STARTUP_FRAMES)
                    next_state = ATTACK_ACTIVE;
            ATTACK_ACTIVE:
                if (frame_counter >= ACTIVE_FRAMES)
                    next_state = ATTACK_RECOVER;
            ATTACK_RECOVER:
                if (frame_counter >= RECOVER_FRAMES)
                    next_state = IDLE;
        endcase
    end

    always @(posedge game_clk) begin
        state <= current_state;
    end

endmodule