module countdown_display(
    input [9:0] x,
    input [9:0] y,
    input [1:0] countdown_value,
    output reg [7:0] color_out,
    input in_digit_area
);

    always @(*) begin
        if (in_digit_area) begin
            case (countdown_value)
                2'b11: color_out = 8'b11111111; // White for 3
                2'b10: color_out = 8'b11100000; // Red for 2
                2'b01: color_out = 8'b00011100; // Green for 1
                default: color_out = 8'b00000000; // Black
            endcase
        end else begin
            color_out = 8'b00000000; // Transparent/black
        end
    end

endmodule